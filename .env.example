# ---------------------------------------------------------------------------
# AI Interview Ready - environment template
# ---------------------------------------------------------------------------
# This is a REFERENCE file. Create the real files locally:
#
#   backend/.env   <- copy the Backend variables below
#   frontend/.env  <- copy the Frontend variables below
#
# Never commit the real .env files. They are ignored by Git.
# ---------------------------------------------------------------------------

# ------------------------------- Backend -----------------------------------
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_interview_ready
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ai_interview_ready

# Neo4j (optional)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# ------------------------------- Frontend ----------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_OPENAI_API_KEY=sk-your-key-here
